# --- Required ---
# Token from @BotFather. Must be the SAME bot that owns the existing packs
# (pack names end in _by_<botusername>, only that bot can add to them).
BOT_TOKEN=123456:replace-me
# Your numeric Telegram user id. Packs are created under this user.
# You must have opened a DM with the bot and pressed Start once.
OWNER_ID=123456789

# --- Optional ---
# Packs are named <base>_<n>_by_<botusername>
PACK_BASENAME=stickies
# Pack title prefix (default: capitalised basename)
#PACK_TITLE=Stickies
# Other packs whose stickers count as "already have"
#EXTRA_PACKS=packname1,packname2
# Besides the owner: user ids that may /grab, /steal and DM photos/GIFs/videos
#ALLOWED_USERS=111,222
# If set, only hoover stickers in these group ids
#ALLOWED_CHATS=-100123
# 0 = only hoover stickers sent in DM
#HOOVER_GROUPS=1
#DEFAULT_EMOJI=🙂
# Set to Luke's user id to enable the trolling
#LUKE_ID=0
# 0..1 chance of a troll message per hoovered group sticker
#TROLL_CHANCE=1.0
